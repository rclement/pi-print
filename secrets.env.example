# Copy to secrets.env (same folder as setup.sh) and fill in.
# Use SINGLE quotes around values; a value containing a single quote is not supported.
# secrets.env is deleted by setup.sh at the end of a successful run.

# --- Wi-Fi -------------------------------------------------------------------
WIFI_COUNTRY='FR'                    # regulatory domain, required or the radio stays blocked
WIFI_SSID='MyNetwork'
WIFI_BSSID='AA:BB:CC:DD:EE:FF'       # pin to one access point; leave empty ('') to allow any AP
WIFI_PSK='my-wpa2-password'

